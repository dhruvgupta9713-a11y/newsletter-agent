# ==========================================
# AI Newsletter Agent Environment Configuration
# ==========================================

# OpenAI API Key (optional - realistic demo mode activates automatically if empty)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Search API Key (Tavily Search API - optional, demo fallback activates if empty)
TAVILY_API_KEY=your_tavily_api_key_here

# Application Configuration
DEMO_MODE=false
DEFAULT_SUBSCRIBER_COUNT=1420
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
OUTPUT_DIR=outputs
